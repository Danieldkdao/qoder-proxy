{
  "name": "qoder-openai-proxy",
  "version": "3.0.0",
  "description": "OpenAI-compatible API proxy for Qoder CLI",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mts",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit"
  },
  "keywords": [
    "qoder",
    "openai",
    "proxy",
    "api",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
