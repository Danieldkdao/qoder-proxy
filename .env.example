PROXY_API_KEY=replace-with-a-strong-random-secret
QODER_PERSONAL_ACCESS_TOKEN=replace-with-your-qoder-pat
PORT=3000
# Native execution defaults to loopback; Docker sets HOST=0.0.0.0.
# HOST=127.0.0.1
QODER_TIMEOUT_MS=120000
QODER_MAX_CONCURRENCY=1
QODER_MAX_QUEUE=8
QODER_QUEUE_TIMEOUT_MS=30000
QODER_MAX_OUTPUT_TOKENS=16k
MAX_PROMPT_BYTES=2097152
MAX_OUTPUT_BYTES=4194304
DASHBOARD_ENABLED=true
DASHBOARD_PASSWORD=replace-with-a-strong-dashboard-password
# Set SECURE_COOKIES=true when dashboard traffic uses HTTPS.
SECURE_COOKIES=false
# Optional; restart invalidates sessions regardless of this setting.
# DASHBOARD_SECRET=replace-with-a-separate-random-secret
# PUBLIC_BASE_URL=https://your-proxy.example
# CORS_ORIGIN=https://your-client.example
LOG_PAYLOADS=false
LOG_MAX_ENTRIES=500
LOG_BODY_MAX_BYTES=8192
